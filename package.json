  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "better-auth": "1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
