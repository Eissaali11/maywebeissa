    "@typescript-eslint/parser": "^8.26.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "secretlint": "^13.0.5",
    "tailwindcss": "^4",
    "typescript": "^5",
